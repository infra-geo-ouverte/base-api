{
  "name": "@igo2/base-api",
  "version": "1.0.0-next.15",
  "description": "Base Api",
  "homepage": "https://gitlab.forge.gouv.qc.ca/pig/igo2/base-api/packages/base-api#readme",
  "repository": {
    "type": "git",
    "url": "https://gitlab.forge.gouv.qc.ca/pig/igo2/base-api.git"
  },
  "bugs": {
    "url": "https://gitlab.forge.gouv.qc.ca/pig/igo2/base-api/issues"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc -p tsconfig.lib.json",
    "postbuild": "node --import tsx ../../scripts/src/postbuild.mts base-api",
    "types": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "eslint ./src --ext .ts",
    "lint.fix": "eslint --fix ./src --ext .ts"
  },
  "exports": {
    ".": {
      "import": "./src/public-api.ts"
    }
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.0.0",
    "handlebars": "^4.0.0",
    "xss": "^1.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.11"
  }
}
