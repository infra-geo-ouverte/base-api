{
  "name": "@igo2/fastify",
  "version": "1.0.0-next.16",
  "description": "Base Api for Fastify",
  "homepage": "https://gitlab.forge.gouv.qc.ca/pig/igo2/base-api/packages/fastapi#readme",
  "repository": {
    "type": "git",
    "url": "https://gitlab.forge.gouv.qc.ca/pig/igo2/base-api.git"
  },
  "bugs": {
    "url": "https://gitlab.forge.gouv.qc.ca/pig/igo2/base-api/issues"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc -p tsconfig.lib.json",
    "postbuild": "node --import tsx ../../scripts/src/postbuild.mts fastify",
    "types": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "eslint ./src --ext .ts",
    "lint.fix": "eslint --fix ./src --ext .ts",
    "test": "node --import tsx --test \"./src/**/*.test.ts\""
  },
  "exports": {
    ".": {
      "import": "./src/public-api.ts"
    }
  },
  "dependencies": {
    "@fastify/env": "^6.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@fastify/type-provider-typebox": "^6.0.0",
    "camelcase": "^9.0.0",
    "drizzle-orm": "^1.0.0-rc.2",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.0.0",
    "pino": "^10.0.0",
    "sequelize": "^6.0.0",
    "sequelize-typescript": "^2.0.0"
  },
  "peerDependencies": {
    "@sentry/node": "^10.0.0",
    "axios": "^1.0.0",
    "fastify": "^5.0.0",
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6"
  }
}
