{
  "name": "@igo2/hapi",
  "version": "0.0.1",
  "description": "Base hapi api",
  "homepage": "https://gitlab.forge.gouv.qc.ca/igo2/base-api/packages/hapi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.forge.gouv.qc.ca/igo2/base-api.git"
  },
  "bugs": {
    "url": "https://gitlab.forge.gouv.qc.ca/igo2/base-api/issues"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc -p tsconfig.lib.json",
    "postbuild": "node --import tsx ../../scripts/src/postbuild.mts hapi",
    "types-check": "tsc --noEmit",
    "lint": "eslint ./src --ext .ts",
    "lint.fix": "eslint --fix ./src --ext .ts"
  },
  "exports": {
    ".": {
      "import": "./src/public-api.ts"
    }
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/catbox-redis": "^7.0.2",
    "@hapi/inert": "^7.1.0",
    "@hapi/vision": "^7.0.3",
    "@igo2/base-api": "*",
    "blipp": "^4.0.2",
    "camelcase": "^6.3.0",
    "elastic-apm-node": "^4.0.0",
    "hapi-dev-errors": "^4.0.0",
    "hapi-pino": "^12.1.0",
    "hapi-swagger": "^17.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "md5": "^2.3.0",
    "nconf": "^0.13.0",
    "nodemailer": "^6.9.9",
    "pg": "^8.11.3",
    "pino-pretty": "^10.3.1"
  },
  "peerDependencies": {
    "@hapi/hapi": "^21.3.2",
    "sequelize": "^6.33.0",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@types/md5": "^2.3.6",
    "@types/nconf": "^0.10.7",
    "@types/nodemailer": "^7.0.3",
    "@types/validator": "^13.11.2"
  }
}
